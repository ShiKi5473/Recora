<?xml version="1.0" encoding="utf-8"?>
<!--
  錄刻 Recora 的圖示（依 docs/logo.png 描繪）：外圓、內圈、C 弧、R 字母（單色主題圖示，不含錄影點，由系統著色）。
  原圖 2048 px 的圓心 (1023,1023) 對到 (54,54)，縮放 0.0587；R 的斜腳收在安全區（半徑 33）以內。
  線條比原圖加粗一倍，縮成桌面圖示才看得清楚。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 外圓 -->
    <path
        android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z"
        android:strokeColor="#585755"
        android:strokeWidth="2.2" />
    <!-- 內圈：從 R 的直筆底部繞過左、上、右，停在斜腳 -->
    <path
        android:pathData="M54,74.7A20.7,20.7 0,1 1,69.86 67.31"
        android:strokeColor="#585755"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
    <!-- C 弧 -->
    <path
        android:pathData="M37.56,54A17.5,17.5 0,0 1,46.93 37.15"
        android:strokeColor="#585755"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />
    <!-- R：直筆、上方的圓弧、斜腳 -->
    <path
        android:pathData="M54,74.7V38.86H59.28A6.6,6.6 0,0 1,59.28 52.06H54M59.28,52.06L76.9,77.2"
        android:strokeColor="#585755"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
